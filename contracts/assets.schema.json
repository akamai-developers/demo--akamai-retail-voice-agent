{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product image asset manifest",
  "description": "src/retail_voice/data/assets.json, written by tools/make_assets.py. One entry per packaged image. Startup checks checksums, ownership and that each file resolves inside data/products/. Human review of the images is recorded in review_status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,4}$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "tenant_id",
        "product_id",
        "variant_ids",
        "color",
        "filename",
        "mime_type",
        "alt_text",
        "sha256",
        "provenance",
        "generator",
        "created",
        "redistribution_basis",
        "review_status"
      ],
      "properties": {
        "image_id": {"type": "string", "pattern": "^img-[a-z0-9][a-z0-9-]{0,63}$"},
        "tenant_id": {"enum": ["retailer-a", "retailer-b"]},
        "product_id": {"$ref": "#/$defs/id"},
        "variant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "color": {"type": "string", "pattern": "^[a-z]{3,20}$"},
        "filename": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,80}\\.jpg$"},
        "mime_type": {"const": "image/jpeg"},
        "alt_text": {"type": "string", "minLength": 1, "maxLength": 200},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provenance": {"const": "synthetic"},
        "generator": {"type": "string", "pattern": "^OpenAI gpt-image-[0-9.]+, prompt and JPEG encode by tools/make_assets\\.py at commit [0-9a-f]{7,40}$"},
        "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "redistribution_basis": {"type": "string", "minLength": 1, "maxLength": 200},
        "review_status": {"enum": ["pending review", "approved", "rejected"]}
      }
    }
  }
}
