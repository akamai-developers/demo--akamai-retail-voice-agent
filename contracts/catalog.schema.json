{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic retail catalog envelope",
  "description": "src/retail_voice/data/catalog.json. Read-only seed for the storefront and the model tools. Cross-references (ownership, variants, images, stock rows) are checked by catalog_repository.py at startup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "currency",
    "retailers",
    "stores",
    "products",
    "inventory",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,4}$"},
    "currency": {"enum": ["USD"]},
    "retailers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/retailer"}
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/store"}
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/product"}
    },
    "inventory": {
      "type": "array",
      "items": {"$ref": "#/$defs/inventory"}
    },
    "assets": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.json$"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "image_id": {"type": "string", "pattern": "^img-[a-z0-9][a-z0-9-]{0,63}$"},
    "tenant": {"enum": ["retailer-a", "retailer-b"]},
    "retailer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "name"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/tenant"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "store_id", "name", "timezone"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/tenant"},
        "store_id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "timezone": {
          "description": "IANA time zone of the store, for date and time answers. catalog_repository.py also checks that the zone exists.",
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}$"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "color", "size"],
      "properties": {
        "variant_id": {"$ref": "#/$defs/id"},
        "color": {"type": "string", "pattern": "^[a-z]{3,20}$"},
        "size": {"enum": ["XS", "S", "M", "L", "XL", "OS"]},
        "image_id": {"$ref": "#/$defs/image_id"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "product_id",
        "name",
        "description",
        "category",
        "tags",
        "price_minor",
        "image_ids",
        "variants"
      ],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/tenant"},
        "product_id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "minLength": 1, "maxLength": 300},
        "category": {"enum": ["jackets", "rain-shells", "fleeces", "vests", "hats", "gloves"]},
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z-]{1,23}$"}
        },
        "price_minor": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "image_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/image_id"}
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/variant"}
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "store_id", "product_id", "variant_id", "quantity", "provenance"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/tenant"},
        "store_id": {"$ref": "#/$defs/id"},
        "product_id": {"$ref": "#/$defs/id"},
        "variant_id": {"$ref": "#/$defs/id"},
        "quantity": {"type": "integer", "minimum": 0, "maximum": 100000},
        "provenance": {"const": "synthetic"}
      }
    }
  }
}
