# Cloud settings for make deploy. Runtime keys stay in .local/gateway.env.
# Keep LINODE_TOKEN in your shell, never in this file.
SITE_NAME=retail-demo
LINODE_REGION=nl-ams
# Supported plan: one 96 GB RTX PRO 6000 Blackwell. Other plans fail before provisioning.
GPU_TYPE=g3-gpu-rtxpro6000-blackwell-1
# Pinned model stack listed in README.md. No compact or multi-GPU profile yet.
MODEL_PROFILE=retail-full
# Tested defaults: 16,384 tokens, one model request, FP8 KV cache.
# Allowed context: 2048-32768. Changes need a new SITE_NAME and fresh validation.
VLLM_MAX_MODEL_LEN=16384
# vLLM's total GPU memory budget, including weights, runtime overhead and KV cache.
# Allowed: 0.40-0.85. This fraction is not the size of the KV cache.
VLLM_GPU_MEMORY_UTILIZATION=0.70
# false deploys voice shopping without the image model or live try-on worker.
TRYON_ENABLED=true
# Empty means this computer's public IPv4 address. Add other allowed IPv4 /32
# addresses as a comma-separated list that includes this computer.
ADMIN_CIDR=
# Local browser port. The local mock uses 8765.
LOCAL_PORT=8766
